{
	"name": "simple-svelte-embeds",
	"version": "0.0.1",
	"description": "Minimal Svelte iframe embeds",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"demo": "npm run dev --prefix demo",
		"test": "playwright test"
	},
	"files": [
		"src"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./src/Embed.svelte",
	"exports": {
		"./*": "./src/*"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"embed",
		"youtube",
		"vimeo",
		"iframe"
	]
}
