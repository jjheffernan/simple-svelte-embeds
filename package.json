{
	"name": "simple-svelte-embeds",
	"version": "0.0.1",
	"description": "Minimal Svelte 5 iframe embeds — zero runtime deps, privacy-friendly defaults",
	"license": "MIT",
	"type": "module",
	"author": "jjheffernan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jjheffernan/simple-svelte-embeds.git"
	},
	"homepage": "https://github.com/jjheffernan/simple-svelte-embeds#readme",
	"bugs": {
		"url": "https://github.com/jjheffernan/simple-svelte-embeds/issues"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"demo": "npm run dev --prefix demo",
		"test": "playwright test",
		"prepublishOnly": "npm run check && npm test"
	},
	"files": [
		"src"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./src/Embed.svelte",
	"exports": {
		"./*": "./src/*"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"astro",
		"embed",
		"iframe",
		"youtube",
		"vimeo",
		"spotify",
		"instagram",
		"tiktok",
		"bluesky",
		"facebook",
		"twitter",
		"x",
		"soundcloud",
		"reddit",
		"codepen",
		"gist"
	]
}
